# --- LINE Official Account (Messaging API) ---
# Console: https://developers.line.biz/console/
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# LINE user ID or group ID that should receive lead handoff notifications
# (invite the OA into a staff group, then read the group ID from a webhook log)
LINE_STAFF_NOTIFY_ID=

# --- Google Gemini (free tier) ---
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Free-tier quota is counted per model, so the fallback has its own daily
# allowance: when the primary runs out the bot keeps answering on the other one
# instead of going quiet for the rest of the day.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# --- Conversation behaviour ---
# How long to wait for the customer to finish typing before answering, in ms.
# Customers often send one thought as several short messages; the bot merges
# whatever arrives inside this window into a single reply. Lower it if replies
# start hitting the hosting platform's function timeout.
MESSAGE_DEBOUNCE_MS=8000

# --- Database (Postgres, e.g. Neon/Supabase free tier) ---
DATABASE_URL=

# --- Dashboard login ---
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
# random long string used to sign the dashboard session cookie
SESSION_SECRET=
