// A5 Design LINE OA Chatbot — data model
// Two jobs this schema supports:
//  1) Lead capture & handoff to staff (Lead, Project, StaffNotification)
//  2) Conversation -> market data for analytics (Conversation, Message)
//
// Lead is the customer's persistent identity (one row per LINE user, forever).
// Project is one service request from them. The split exists so a returning
// customer asking about a second, unrelated job gets a new Project instead of
// overwriting the details of their first one — see getOrCreateLeadAndConversation
// in src/lib/lead.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  NEW // just started chatting, not enough info yet
  HANDED_OFF // enough info collected / customer asked for a human, staff notified
  CONTACTED // staff has followed up
  CLOSED // done (won, lost, or not a real lead)
}

enum MessageRole {
  USER
  BOT
  SYSTEM // e.g. handoff notices, not shown to the customer
}

model Lead {
  id          String  @id @default(cuid())
  lineUserId  String  @unique
  displayName String?

  // PDPA: when the data-collection notice was shown/acknowledged to this user
  consentShownAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]

  @@index([createdAt])
}

// One service request/inquiry from a customer. A new one is started whenever
// the customer's most recent project has already been settled (handed off,
// contacted, or closed) — see SETTLED_STATUSES in src/lib/lead.ts — so an old
// inquiry's details stay intact instead of being overwritten by the next one.
model Project {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id])

  phone String?
  // One of PROJECT_TYPES in src/lib/policy.ts — a fixed vocabulary so the
  // dashboard groups cleanly instead of splitting one category across wordings.
  projectType String?
  // The customer's own description, e.g. "ต่อเติมครัวหลังบ้าน 20 ตร.ม."
  projectDetail String?
  budgetRange String?
  location    String?
  timeline    String?
  contactNote String? // e.g. preferred time to be contacted
  notes       String? // free-text notes staff can edit
  status      ProjectStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations      Conversation[]
  staffNotifications StaffNotification[]

  @@index([status])
  @@index([createdAt])
  @@index([leadId])
}

model Conversation {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  startedAt  DateTime @default(now())
  lastActive DateTime @default(now())

  messages Message[]

  @@index([projectId])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           MessageRole

  // Customer-facing text. For image messages this holds the AI-generated
  // description/summary of the photo, never the raw image bytes (PDPA: keep
  // only what's needed to route the lead, not the customer's original file).
  content String

  hasImage Boolean @default(false)

  // Market-data tags, filled in by the AI classification step
  topic     String? // e.g. "ราคา", "แบบบ้าน", "ระยะเวลา", "ติดต่อทีมงาน"
  sentiment String? // "positive" | "neutral" | "negative"

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([topic])
  @@index([createdAt])
}

// Short-lived queue of inbound LINE messages. Customers usually type in
// fragments ("สวัสดี" / "อยากติดต่อเรื่อง" / "การต่อเติม"), so each message waits
// a couple of seconds here; whichever invocation finds itself holding the newest
// message claims the whole batch, merges it, and answers once.
model PendingMessage {
  id            String   @id @default(cuid())
  lineUserId    String
  lineMessageId String   @unique
  kind          String // "text" | "image"
  text          String   @default("")
  replyToken    String
  createdAt     DateTime @default(now())
  processedAt   DateTime?

  @@index([lineUserId, processedAt])
}

model StaffNotification {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  channel   String // "line"
  status    String // "sent" | "failed"
  message   String // the text that was sent to staff
  error     String?
  createdAt DateTime @default(now())

  @@index([projectId])
}

// Who did what, to which record, and when — for the dashboard's manual
// edit/delete/merge actions (src/app/api/dashboard/**). No relation to
// Project: the target may already be deleted or merged away by the time
// anyone looks at the log, so targetId is a loose reference rather than a
// foreign key.
model AuditLog {
  id         String   @id @default(cuid())
  username   String
  action     String // "update" | "delete" | "merge"
  targetType String // "Project"
  targetId   String
  detail     String // human-readable summary of what changed
  createdAt  DateTime @default(now())

  @@index([targetId])
  @@index([createdAt])
}
